# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma:2b
OLLAMA_TIMEOUT_SECONDS=5
OLLAMA_GENERATE_TIMEOUT_SECONDS=120

# Application
APP_ENV=development
# APP_ENV=production requires explicit CORS_ORIGINS (not *)

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=console
# APP_VERSION=dev

# Metrics (EMF to stdout; default on in production)
# METRICS_ENABLED=false
# METRICS_NAMESPACE=OllamaChat

# Optional OpenTelemetry tracing
# OTEL_ENABLED=false
# OTEL_SERVICE_NAME=ollama-chat-api
# OTEL_EXPORTER=console
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# CORS (comma-separated origins, or * for local dev only)
CORS_ORIGINS=*

# Optional API key for POST /api/chat (header: X-API-Key)
# API_KEY=
# Set true in production to fail startup when API_KEY is unset
# REQUIRE_API_KEY_IN_PRODUCTION=false

# Rate limiting
RATE_LIMIT_DEFAULT=60 per minute
RATE_LIMIT_CHAT=20 per minute
RATE_LIMIT_READY=120 per minute

# Behind ALB / reverse proxy (client IP for rate limits)
TRUST_PROXY_COUNT=1

# Request body size limit (bytes)
MAX_CONTENT_LENGTH=65536

# Gunicorn (production / Docker — user-data sets 0.0.0.0:5000 in container)
GUNICORN_BIND=127.0.0.1:5000
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=120
GUNICORN_GRACEFUL_TIMEOUT=30
